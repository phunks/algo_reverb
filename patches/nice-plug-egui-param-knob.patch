+use egui::{Button, Response, Ui, Widget};
+use nice_plug_core::{
+    context::gui::ParamSetter,
+    params::{EnumParam, Param, enums::Enum},
+};
+
+/// A host-aware button selecting one enum variant, suitable for a row of choices.
+/// Clicking the already selected variant does not send a redundant host edit.
+#[must_use = "Add this widget with ui.add(widget)"]
+pub struct ParamEnumButton<'a, T: Enum + PartialEq> {
+    param: &'a EnumParam<T>,
+    setter: &'a ParamSetter<'a>,
+    value: Option<T>,
+}
+
+impl<'a, T: Enum + PartialEq> ParamEnumButton<'a, T> {
+    pub fn for_param(param: &'a EnumParam<T>, setter: &'a ParamSetter<'a>, value: T) -> Self {
+        Self {
+            param,
+            setter,
+            value: Some(value),
+        }
+    }
+
+    /// Show the current variant and cycle to the next variant on activation.
+    /// For a two-variant enum this acts as a single toggle switch.
+    pub fn cycling(param: &'a EnumParam<T>, setter: &'a ParamSetter<'a>) -> Self {
+        Self {
+            param,
+            setter,
+            value: None,
+        }
+    }
+}
+
+impl<T: Enum + PartialEq> Widget for ParamEnumButton<'_, T> {
+    fn ui(self, ui: &mut Ui) -> Response {
+        let current = self.param.modulated_plain_value().to_index();
+        let cycling = self.value.is_none();
+        let index = self.value.map(Enum::to_index).unwrap_or(current);
+        let label = T::variants()[index];
+        let mut response = ui.add(Button::new(label).selected(if cycling {
+            current != 0
+        } else {
+            current == index
+        }));
+        let latest = self.param.modulated_plain_value().to_index();
+        let target = if cycling {
+            (latest + 1) % T::variants().len()
+        } else {
+            index
+        };
+        if response.clicked() && latest != target {
+            self.setter.begin_set_parameter(self.param);
+            self.setter.set_parameter(self.param, T::from_index(target));
+            self.setter.end_set_parameter(self.param);
+            response.mark_changed();
+        }
+        response
+    }
+}
