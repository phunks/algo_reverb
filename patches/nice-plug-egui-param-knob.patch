+use egui::{Button, Response, Ui, Widget, WidgetText};
+use nice_plug_core::{
+    context::gui::ParamSetter,
+    params::{BoolParam, Param},
+};
+
+/// A host-aware toggle button for a boolean parameter.
+///
+/// The selected state follows the parameter each frame, including host automation.
+/// Each activation flips the value and sends one complete host edit gesture.
+#[must_use = "Add this widget with ui.add(widget)"]
+pub struct ParamButton<'a> {
+    param: &'a BoolParam,
+    setter: &'a ParamSetter<'a>,
+    text: WidgetText,
+}
+
+impl<'a> ParamButton<'a> {
+    /// Create a toggle button using the parameter's name as its label.
+    pub fn for_param(param: &'a BoolParam, setter: &'a ParamSetter<'a>) -> Self {
+        Self {
+            param,
+            setter,
+            text: param.name().into(),
+        }
+    }
+
+    /// Override the button label without changing the parameter's name.
+    pub fn with_label(mut self, text: impl Into<WidgetText>) -> Self {
+        self.text = text.into();
+        self
+    }
+}
+
+impl Widget for ParamButton<'_> {
+    fn ui(self, ui: &mut Ui) -> Response {
+        let mut response =
+            ui.add(Button::new(self.text).selected(self.param.modulated_plain_value()));
+        if response.clicked() {
+            self.setter.begin_set_parameter(self.param);
+            self.setter
+                .set_parameter(self.param, !self.param.modulated_plain_value());
+            self.setter.end_set_parameter(self.param);
+            response.mark_changed();
+        }
+        response
+    }
+}
