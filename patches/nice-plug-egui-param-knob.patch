+use egui::{Response, Ui, Widget};
+use egui_knob::{Knob, KnobStyle};
+use nice_plug_core::{context::gui::ParamSetter, params::Param};
+
+/// An egui_knob widget connected to a nice-plug parameter.
+///
+/// Reads the parameter on every frame, including host automation. The knob works
+/// in normalized space so parameter skew, stepping, and units remain authoritative.
+/// Drag vertically to edit, hold Shift for fine adjustment, and double-click or
+/// control/command-click to reset. Scrolling is opt-in. Unlike ParamSlider, this
+/// widget does not currently support text entry.
+///
+/// Keep the widget present through the end of a drag so the host receives the
+/// corresponding end-gesture notification.
+#[must_use = "Add this widget with ui.add(widget)"]
+pub struct ParamKnob<'a, P: Param> {
+    param: &'a P,
+    setter: &'a ParamSetter<'a>,
+    size: f32,
+    style: KnobStyle,
+    draw_value: bool,
+    allow_scroll: bool,
+}
+
+impl<'a, P: Param> ParamKnob<'a, P> {
+    pub fn for_param(param: &'a P, setter: &'a ParamSetter<'a>) -> Self {
+        Self {
+            param,
+            setter,
+            size: 40.0,
+            style: KnobStyle::Wiper,
+            draw_value: true,
+            allow_scroll: false,
+        }
+    }
+
+    /// Set the knob diameter in logical pixels.
+    pub fn with_size(mut self, size: f32) -> Self {
+        if size.is_finite() && size > 0.0 {
+            self.size = size;
+        }
+        self
+    }
+
+    pub fn with_style(mut self, style: KnobStyle) -> Self {
+        self.style = style;
+        self
+    }
+
+    pub fn without_value(mut self) -> Self {
+        self.draw_value = false;
+        self
+    }
+
+    pub fn with_scroll(mut self, enabled: bool) -> Self {
+        self.allow_scroll = enabled;
+        self
+    }
+}
+
+impl<P: Param> Widget for ParamKnob<'_, P> {
+    fn ui(self, ui: &mut Ui) -> Response {
+        // Do not cache the parameter: the host can change it independently of us.
+        let mut normalized = self.param.modulated_normalized_value();
+        ui.vertical_centered(|ui| {
+            let sensitivity = if ui.input(|i| i.modifiers.shift) {
+                0.0005
+            } else {
+                0.005
+            };
+            let mut knob = Knob::new(&mut normalized, 0.0, 1.0, self.style)
+                .with_size(self.size)
+                .with_drag_sensitivity(sensitivity)
+                .with_double_click_reset(self.param.default_normalized_value());
+            if self.allow_scroll {
+                knob = knob.with_middle_scroll();
+            }
+            let mut response = ui.add(knob);
+            let gesture_id = response.id.with("param-knob-gesture");
+            let mut active = ui.data(|data| data.get_temp::<bool>(gesture_id).unwrap_or(false));
+            if response.is_pointer_button_down_on() && !active {
+                self.setter.begin_set_parameter(self.param);
+                active = true;
+            }
+
+            let reset = response.double_clicked()
+                || (response.clicked() && ui.input(|i| i.modifiers.ctrl || i.modifiers.command));
+            if reset || response.changed() {
+                let value = if reset {
+                    self.param.default_plain_value()
+                } else {
+                    // Snap discrete parameters before notifying the host.
+                    self.param.preview_plain(normalized)
+                };
+                if value != self.param.modulated_plain_value() {
+                    if !active {
+                        self.setter.begin_set_parameter(self.param);
+                    }
+                    self.setter.set_parameter(self.param, value);
+                    if !active {
+                        self.setter.end_set_parameter(self.param);
+                    }
+                    response.mark_changed();
+                }
+            }
+            if active && !response.is_pointer_button_down_on() {
+                self.setter.end_set_parameter(self.param);
+                active = false;
+            }
+            ui.data_mut(|data| data.insert_temp(gesture_id, active));
+            if self.draw_value {
+                ui.label(self.param.to_string());
+            }
+            response.on_hover_text(self.param.name())
+        })
+        .inner
+    }
+}
