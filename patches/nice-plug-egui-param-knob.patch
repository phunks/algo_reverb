+use egui::{ComboBox, Response, Ui, Widget};
+use nice_plug_core::{
+    context::gui::ParamSetter,
+    params::{EnumParam, Param, enums::Enum},
+};
+
+/// A host-aware combo box for an enum parameter.
+///
+/// Variant labels come from [`Enum::variants()`]. Selecting a different variant
+/// sends one complete host edit gesture. Host automation is read each frame.
+#[must_use = "Add this widget with ui.add(widget)"]
+pub struct ParamComboBox<'a, T: Enum + PartialEq> {
+    param: &'a EnumParam<T>,
+    setter: &'a ParamSetter<'a>,
+    width: Option<f32>,
+}
+
+impl<'a, T: Enum + PartialEq> ParamComboBox<'a, T> {
+    pub fn for_param(param: &'a EnumParam<T>, setter: &'a ParamSetter<'a>) -> Self {
+        Self {
+            param,
+            setter,
+            width: None,
+        }
+    }
+
+    pub fn with_width(mut self, width: f32) -> Self {
+        self.width = Some(width);
+        self
+    }
+}
+
+impl<T: Enum + PartialEq> Widget for ParamComboBox<'_, T> {
+    fn ui(self, ui: &mut Ui) -> Response {
+        let current = self.param.modulated_plain_value().to_index();
+        let mut combo =
+            ComboBox::from_id_salt(ui.next_auto_id()).selected_text(T::variants()[current]);
+        if let Some(width) = self.width {
+            combo = combo.width(width);
+        }
+        let mut changed = false;
+        let mut response = combo
+            .show_ui(ui, |ui| {
+                for (index, label) in T::variants().iter().enumerate() {
+                    if ui.selectable_label(index == current, *label).clicked()
+                        && self.param.modulated_plain_value().to_index() != index
+                    {
+                        self.setter.begin_set_parameter(self.param);
+                        self.setter.set_parameter(self.param, T::from_index(index));
+                        self.setter.end_set_parameter(self.param);
+                        changed = true;
+                    }
+                }
+            })
+            .response;
+        if changed {
+            response.mark_changed();
+        }
+        response
+    }
+}
